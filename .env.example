# Aplicação
APP_URL=http://localhost:5173

# Banco de dados
# Os microsserviços utilizam DATABASE_URL como conexão padrão
# quando uma conexão específica não é definida.
DATABASE_URL=postgresql://usuario:senha@host:5432/portal_escarlate

# Use false apenas quando o banco local não utilizar SSL.
DATABASE_SSL=true

# Segurança
# Substitua por valores aleatórios e diferentes entre si.
AUTH_SECRET=gere-uma-chave-secreta
INTERNAL_SERVICE_TOKEN=gere-um-token-interno
SECRETS_ENCRYPTION_KEY=gere-uma-chave-de-criptografia

# Google OAuth / Gmail
# Necessário para conectar contas Gmail e enviar
# e-mails de cadastro e recuperação de senha.
GOOGLE_CLIENT_ID=seu-google-client-id
GOOGLE_CLIENT_SECRET=seu-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback

# Remetente
EMAIL_FROM_NAME=Portal Escarlate