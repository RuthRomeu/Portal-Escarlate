# =============================================================================
# Portal Escarlate — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores marcados com <...>
#
# NÃO COMMITE o arquivo .env — ele está no .gitignore
# =============================================================================

# ---------------------------------------------------------------------------
# Aplicação
# URL pública do frontend (usada para gerar links nos e-mails).
# ---------------------------------------------------------------------------
APP_URL=http://localhost:5173

# Origens permitidas para requisições CORS (separadas por vírgula).
# Inclua o IP da sua máquina se for testar com dispositivo físico Android.
# Exemplo: http://localhost:5173,http://127.0.0.1:5173,http://SEU_IP:3100
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Banco de dados (desenvolvimento local)
#
# O docker-compose.prod.yml usa o PostgreSQL interno do stack (porta 5435).
# Para rodar o backend Node.js fora do Docker, aponte para um PostgreSQL local.
#
# ATENÇÃO: Se tiver PostgreSQL instalado nativamente no Windows, ele ocupa
# a porta 5432. Use outra porta para o container Docker (ex: 5434 ou 5435).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/portal_escarlate?sslmode=disable
DATABASE_SSL=false

# URLs específicas por serviço Node.js (usadas em desenvolvimento local).
# No docker-compose.prod.yml essas variáveis são sobrescritas automaticamente.
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5435/portal_escarlate?sslmode=disable
REGISTRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5435/portal_escarlate?sslmode=disable
PASSWORD_RECOVERY_DATABASE_URL=postgresql://postgres:postgres@localhost:5435/portal_escarlate?sslmode=disable
NEWS_DATABASE_URL=postgresql://postgres:postgres@localhost:5435/portal_escarlate?sslmode=disable
ARTICLE_SUMMARY_DATABASE_URL=postgresql://postgres:postgres@localhost:5435/portal_escarlate?sslmode=disable
AI_SERVICE_DATABASE_URL=postgresql://postgres:postgres@localhost:5435/portal_escarlate?sslmode=disable
EMAIL_DATABASE_URL=postgresql://postgres:postgres@localhost:5435/portal_escarlate?sslmode=disable

# ---------------------------------------------------------------------------
# Segurança
# Gere valores aleatórios e diferentes para cada um.
# Exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

# Chave de assinatura dos cookies de sessão JWT.
# Deve ser idêntica nos serviços Node.js e Dart (ambos precisam validar sessões).
AUTH_SECRET=<gere-uma-chave-secreta-minimo-32-chars>

# Token de autenticação entre microsserviços Node.js (header x-internal-service-token).
INTERNAL_SERVICE_TOKEN=<gere-um-token-interno>

# Token de autenticação entre microsserviços Dart (header x-internal-token).
# Deve ter o mesmo valor que INTERNAL_SERVICE_TOKEN para o gateway Dart
# conseguir chamar o gateway Node.js via LEGACY_BACKEND_URL.
PORTAL_INTERNAL_TOKEN=<mesmo-valor-que-INTERNAL_SERVICE_TOKEN>

# Chave de criptografia AES-GCM usada pelo Email Service Dart para
# armazenar refresh tokens do Gmail de forma cifrada no banco.
SECRETS_ENCRYPTION_KEY=<gere-uma-chave-de-criptografia-minimo-32-chars>

# Senha do PostgreSQL usado pelo docker-compose.prod.yml.
PORTAL_DB_PASSWORD=<senha-do-postgres-no-compose>

# Segredo para geração de tokens de verificação de e-mail (Registration Dart).
# Mínimo de 32 caracteres.
REGISTRATION_TOKEN_SECRET=<gere-um-segredo-minimo-32-chars>

# Segredo para geração de tokens de recuperação de senha (Password Recovery Dart).
# Mínimo de 32 caracteres.
PASSWORD_RECOVERY_TOKEN_SECRET=<gere-um-segredo-minimo-32-chars>

# ---------------------------------------------------------------------------
# Portas dos microsserviços Node.js
# Altere apenas se houver conflito de portas no seu ambiente.
# ---------------------------------------------------------------------------
PORT=3000
AUTH_SERVICE_PORT=3001
NEWS_SERVICE_PORT=3002
REGISTRATION_SERVICE_PORT=3003
AI_SERVICE_PORT=3004
NEWS_SUMMARY_SERVICE_PORT=3005
EMAIL_SERVICE_PORT=3006
EVENT_SERVICE_PORT=3007
ARTICLE_SUMMARY_SERVICE_PORT=3008
PASSWORD_RECOVERY_SERVICE_PORT=3009

# ---------------------------------------------------------------------------
# Host e URLs internas (desenvolvimento local fora do Docker)
#
# HOST=0.0.0.0 permite que os servidores aceitem conexões externas
# (necessário para testar com dispositivo físico Android).
#
# As *_SERVICE_URL evitam que HOST=0.0.0.0 seja usado como destino
# nas chamadas internas entre microsserviços.
# ---------------------------------------------------------------------------
HOST=0.0.0.0
EVENT_SERVICE_HOST=127.0.0.1

AUTH_SERVICE_URL=http://127.0.0.1:3001
REGISTRATION_SERVICE_URL=http://127.0.0.1:3003
PASSWORD_RECOVERY_SERVICE_URL=http://127.0.0.1:3009
EMAIL_SERVICE_URL=http://127.0.0.1:3006
NEWS_SERVICE_URL=http://127.0.0.1:3002
ARTICLE_SUMMARY_SERVICE_URL=http://127.0.0.1:3008
AI_SERVICE_URL=http://127.0.0.1:3004
NEWS_SUMMARY_SERVICE_URL=http://127.0.0.1:3005
EVENT_SERVICE_URL=http://127.0.0.1:3007

# ---------------------------------------------------------------------------
# Google OAuth / Gmail
#
# Necessário para envio de e-mails de verificação e recuperação de senha.
# Obtenha as credenciais em: https://console.cloud.google.com/apis/credentials
#
# GOOGLE_REDIRECT_URI deve ser adicionada nas "Authorized redirect URIs"
# do seu OAuth Client no Google Cloud Console.
#
# Para o stack Docker (docker-compose.prod.yml), use a porta 3100 (gateway Dart).
# Para desenvolvimento local (Node.js direto), use a porta 3000 (gateway Node.js).
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=<seu-google-client-id>
GOOGLE_CLIENT_SECRET=<seu-google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:3100/api/google/callback

# ---------------------------------------------------------------------------
# Remetente dos e-mails
# ---------------------------------------------------------------------------
EMAIL_FROM_NAME=Portal Escarlate

# ---------------------------------------------------------------------------
# NewsAPI
# Obtenha uma chave gratuita em: https://newsapi.org/register
#
# As chaves também podem ser adicionadas pelo painel admin via banco de dados
# (tabela news_api_keys), sem precisar reiniciar o backend.
# ---------------------------------------------------------------------------
NEWS_API_KEY=<sua-chave-newsapi>

# ---------------------------------------------------------------------------
# OpenRouter (IA)
# Obtenha uma chave em: https://openrouter.ai/keys
#
# As chaves também podem ser adicionadas pelo painel admin via banco de dados
# (tabelas ai_api_keys + ai_models), sem precisar reiniciar o backend.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=<sua-chave-openrouter>
