# =============================================================================
# Portal Escarlate — backend Dart — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores marcados com <...>
#
# Este arquivo é usado para execução local do stack Dart isolado:
#   cd backend-dart && docker compose up -d
#
# Para o stack de produção completo, use o .env na raiz do projeto
# com o docker-compose.prod.yml.
# =============================================================================

# ---------------------------------------------------------------------------
# Segurança
# Deve ser idêntico ao PORTAL_INTERNAL_TOKEN da raiz do projeto.
# Protege as rotas /internal/* de cada microsserviço Dart.
# ---------------------------------------------------------------------------
PORTAL_INTERNAL_TOKEN=<gere-um-token-interno-minimo-32-chars>

# ---------------------------------------------------------------------------
# NATS JetStream
# Usado pelos serviços Registration, Password Recovery e Email para
# comunicação assíncrona via padrão outbox → NATS → inbox.
# ---------------------------------------------------------------------------
NATS_URL=nats://nats:4222

# ---------------------------------------------------------------------------
# PostgreSQL
# O docker-compose.yml do Dart sobe um PostgreSQL na porta 5433
# com múltiplos bancos isolados por serviço.
#
# PORTAL_DB_PASSWORD é a senha do usuário 'portal' criado pelo compose.
# As DATABASE_URL específicas são configuradas automaticamente pelo compose;
# defina aqui apenas se quiser sobrescrever algum serviço individualmente.
# ---------------------------------------------------------------------------
PORTAL_DB_PASSWORD=<senha-do-postgres-dart>

# Opcional — sobrescreve a DATABASE_URL de um serviço específico.
# Por padrão o compose configura cada serviço com seu banco dedicado.
# DATABASE_URL=postgresql://portal:<PORTAL_DB_PASSWORD>@postgres:5432/auth_db?sslmode=disable

# ---------------------------------------------------------------------------
# Auth Service
# Chave de assinatura dos cookies de sessão JWT.
# Deve ser idêntica ao AUTH_SECRET da raiz do projeto (ambos os backends
# precisam validar os mesmos tokens de sessão).
# ---------------------------------------------------------------------------
AUTH_SECRET=<mesmo-valor-que-AUTH_SECRET-na-raiz>

# ---------------------------------------------------------------------------
# Registration Service
# Segredo para derivação HMAC dos tokens de verificação de e-mail.
# Mínimo de 32 caracteres.
# ---------------------------------------------------------------------------
REGISTRATION_TOKEN_SECRET=<gere-um-segredo-minimo-32-chars>

# Habilita o envio de eventos de verificação via NATS JetStream.
# Deixe true para que o Email Service receba e processe os eventos.
REGISTRATION_EVENTS_ENABLED=true

# ---------------------------------------------------------------------------
# Password Recovery Service
# Segredo para derivação HMAC dos tokens de recuperação de senha.
# Mínimo de 32 caracteres.
# ---------------------------------------------------------------------------
PASSWORD_RECOVERY_TOKEN_SECRET=<gere-um-segredo-minimo-32-chars>

# Habilita o envio de eventos de recuperação via NATS JetStream.
PASSWORD_RECOVERY_EVENTS_ENABLED=true

# ---------------------------------------------------------------------------
# Email Service
# Chave de criptografia AES-GCM para os refresh tokens do Gmail no banco.
# Deve ser idêntica ao SECRETS_ENCRYPTION_KEY da raiz do projeto.
# ---------------------------------------------------------------------------
SECRETS_ENCRYPTION_KEY=<mesmo-valor-que-SECRETS_ENCRYPTION_KEY-na-raiz>

# Habilita o consumidor de eventos de e-mail via NATS JetStream.
EMAIL_EVENTS_ENABLED=true

# Google OAuth — necessário para envio de e-mails.
# Obtenha as credenciais em: https://console.cloud.google.com/apis/credentials
# Adicione http://localhost:3100/api/google/callback nas Authorized redirect URIs.
GOOGLE_CLIENT_ID=<seu-google-client-id>
GOOGLE_CLIENT_SECRET=<seu-google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:3100/api/google/callback

# ---------------------------------------------------------------------------
# API Gateway Dart (porta 3100)
# URL de origem do frontend permitida para CORS.
# ---------------------------------------------------------------------------
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL do backend Node.js para repassar rotas não implementadas em Dart
# (news, AI, news-summary, article-summary).
# Deixe vazio para retornar 404 nessas rotas (modo Dart puro).
# LEGACY_BACKEND_URL=http://localhost:3000
