# Copie como .env para comandos locais que carreguem o arquivo.
# Docker Compose utiliza diretamente o ambiente de desenvolvimento.
PORTAL_INTERNAL_TOKEN=change-this-long-random-value
NATS_URL=nats://127.0.0.1:4222
PORTAL_DB_PASSWORD=local_only_change_me
# Opcional; atribuir uma URL diferente a cada serviço em produção.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5433/auth_db?sslmode=disable
